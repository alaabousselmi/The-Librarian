# Copy to .env and fill in. Never commit .env.

# --- LLMs (any OpenAI-compatible endpoint) ---------------------------------
# Default: Groq free tier — one key, three different model families.
# Get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# Answer generation — OpenAI gpt-oss, 120B MoE
GENERATOR_MODEL=openai/gpt-oss-120b
GENERATOR_EXTRA_BODY={"reasoning_effort": "low"}
# Query rewriting — SDAIA ALLaM, 7B dense (different family + size from the generator)
REWRITER_MODEL=allam-2-7b
REWRITER_EXTRA_BODY={}
# Eval judge — Alibaba Qwen3.8, 27B (a third family, so the judge never grades its own family)
JUDGE_MODEL=qwen/qwen3.8-27b
JUDGE_EXTRA_BODY={"reasoning_effort": "none"}

# Using OpenRouter instead of Groq (one key for every model): pin the generator to Groq's endpoint,
# otherwise OpenRouter may route to a provider 4-10x slower (p95 7.2 s vs 2.8 s, docs/optimisation.md).
# allam-2-7b is not on OpenRouter: use meta-llama/llama-3.1-8b-instruct as the rewriter.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# GENERATOR_EXTRA_BODY={"reasoning": {"effort": "low"}, "provider": {"order": ["groq"], "allow_fallbacks": true}}
# REWRITER_MODEL=meta-llama/llama-3.1-8b-instruct
# JUDGE_EXTRA_BODY={"reasoning": {"enabled": false}}

# Per-role overrides, e.g. to move one role to a paid provider or local Ollama:
# GENERATOR_BASE_URL=http://localhost:11434/v1
# GENERATOR_API_KEY=ollama

# --- Corpus -----------------------------------------------------------------
# Needed for GitHub Discussions + issues (fine-grained token, public repo read-only).
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
FASTAPI_REF=0.162.0

# --- Vector store -----------------------------------------------------------
# Leave QDRANT_URL empty to use embedded local mode (data/qdrant), no server needed.
# docker compose sets it to http://qdrant:6333. For deployment use Qdrant Cloud (free 1GB).
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION=librarian

# --- Service ---------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=10
